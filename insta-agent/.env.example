# تنظیم‌های اختیاری ایجنت اینستاگرام
# این فایل را به نام «.env» کنار insta_agent.py کپی کن و فقط خط‌هایی را که لازم داری از حالت توضیح دربیاور.
# بیشتر این‌ها از داخل پنل هم قابل تنظیم‌اند؛ هیچ‌کدام اجباری نیست.

# پورت و نشانی پنل (0.0.0.0 یعنی از دستگاه‌های دیگرِ همان شبکه هم باز شود)
# AGENT_PORT=8787
# AGENT_HOST=127.0.0.1

# کد ورود دلخواه به‌جای کد خودکار
# AGENT_PASSWORD=یک-رمز-طولانی

# پوشهٔ داده‌ها (پیش‌فرض: ~/.insta_agent)
# AGENT_DATA_DIR=/sdcard/insta_agent

# مرورگر را هنگام اجرا باز نکن
# AGENT_NO_BROWSER=1

# پروکسی HTTP برای رسیدن به اینستاگرام (مثلاً v2rayNG)
# AGENT_PROXY=http://127.0.0.1:10809

# توکن پیج (به‌جای چسباندن در پنل)
# IG_ACCESS_TOKEN=IGAA...

# نسخهٔ API اینستاگرام
# IG_API_VERSION=v26.0

# نشانی عمومی خودت برای فایل‌ها (اگر ایجنت روی سرور یا پشت دامنهٔ خودت است)
# AGENT_PUBLIC_URL=https://agent.example.com

# دستور تونل دلخواه؛ {port} با پورت فایل‌ها جایگزین می‌شود
# AGENT_TUNNEL_CMD=cloudflared tunnel --no-autoupdate --url http://127.0.0.1:{port}

# سرویس هوش مصنوعی سازگار با OpenAI برای دستیار (کلید و مدل را در پنل بده)
# AGENT_AI_URL=https://example.com/v1

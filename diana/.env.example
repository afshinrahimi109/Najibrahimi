# 🔒 الگوی تنظیمات دیانا — کپی کن به .env (فایل .env در گیت ذخیره نمیشود)
# cp .env.example .env  ||  python3 online.py --setup

# نوع تونل: auto | ngrok | cloudflared | cloudflare-named | tailscale | none
TUNNEL=auto
PORT=8000

# رمز دسترسی در حالت آنلاین (HTTP Basic Auth) — حتماً عوضش کن
DIANA_USER=diana
DIANA_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# --- ngrok (پیشنهادی؛ دامنه‌ی ثابت رایگان) ---
# dashboard.ngrok.com → Your Authtoken
NGROK_AUTHTOKEN=
# دامنه‌ی ثابت رایگان حسابت، مثلاً abc123.ngrok-free.dev
# خالی بگذاری هم ngrok همان دامنه‌ی ثابت را خودکار استفاده میکند
NGROK_DOMAIN=

# --- Cloudflare Tunnel نامدار (اگر دامنه روی Cloudflare داری) ---
CF_TUNNEL_TOKEN=
PUBLIC_URL=

# --- Quick Tunnel موقت: فقط این ایمیلها اجازه ورود داشته باشند (اختیاری) ---
CF_ALLOWED_MAIL=

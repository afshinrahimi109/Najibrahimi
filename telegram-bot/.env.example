# For local use: copy this file to .env and fill in your own values.
# Never commit .env or send bot/API tokens in chat.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token-from-botfather
TELEGRAM_OWNER_ID=123456789
# Gemini is the alternative provider for chat and voice; if set, it is preferred.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq is also supported for chat and Persian voice transcription.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional fallback for chat/content only (not voice transcription):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_SECONDS=45
# Optional: the bot must be an administrator in this channel before /publish works.
TELEGRAM_CHANNEL_ID=
DATABASE_PATH=./data/drafts.sqlite3

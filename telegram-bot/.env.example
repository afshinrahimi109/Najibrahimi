# For local use: copy this file to .env and fill in your own values.
# Never commit .env or send bot/API tokens in chat.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token-from-botfather
TELEGRAM_OWNER_ID=123456789
# Gemini is the alternative provider for chat and voice; if set, it is preferred.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq is also supported for chat and Persian voice transcription.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional fallback for chat/content only (not voice transcription):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_SECONDS=45
# Optional Telegram-channel publishing. The bot must be a channel administrator.
TELEGRAM_CHANNEL_ID=
# Optional Meta publishing. Never send these values in chat; keep them in local .env only.
# Instagram Login: professional (Creator/Business) account and content-publish permission.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Facebook Page publishing: Page ID and Page access token with pages_manage_posts.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
DATABASE_PATH=./data/drafts.sqlite3
